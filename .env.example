# Copy to .env (or ~/.config/konnect/.env) and fill in your ouderportaal credentials.
# Used by `konnect login` when -u/-p are not given.
KONNECT_USERNAME=your-email@example.com
KONNECT_PASSWORD=your-password
# Portal subdomain, e.g. kindencoludens for kindencoludens.ouderportaal.nl.
# Optional; defaults to kindencoludens.
KONNECT_PORTAL=kindencoludens
